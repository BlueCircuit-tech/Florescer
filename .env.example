# Copie para .env.local (ignorado pelo git) e preencha.
# Na Vercel, as mesmas chaves vão em Settings > Environment Variables.

# IA Flor — chave da API da OpenAI.
# Crédito: https://platform.openai.com/settings/organization/billing/overview (mínimo US$ 5)
# Chave:   https://platform.openai.com/api-keys
# A assinatura do ChatGPT NÃO dá acesso à API: são produtos separados.
# Sem esta variável o endpoint responde 503 e a Flor usa apenas a base local do app.
OPENAI_API_KEY=

# Opcional. Padrão: gpt-5-mini (~US$ 0,0006 por pergunta).
# Use gpt-5.1 para respostas mais elaboradas, a um custo ~8x maior.
FLOR_MODEL=gpt-5-mini

# Supabase (schema planejado; o app ainda roda em localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
